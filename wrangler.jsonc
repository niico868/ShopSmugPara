// Cloudflare hosting: the site is plain static files in ./dist.
// Unknown paths (e.g. /design, /order/SP-ABC123) serve index.html and the app's router takes over.
// Shared design links (/d/<id>) go through worker/index.ts first, which adds the design's picture
// and name to the page's preview tags so the link unfurls as a photo card in WhatsApp, Facebook, etc.
// Music (/music/*) goes through the Worker too, so it can play songs from the R2 music bucket.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shop-smug-para",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/d/*", "/music/*"]
  },
  // Pull requests build a preview with `wrangler preview`, which needs this block (it can stay empty).
  "previews": {},
  // The R2 bucket that holds the site's music (Cloudflare > R2 > shop-smug-para-music). Turn this on only
  // once that bucket exists: deploys fail while it points at a bucket that isn't there.
  // "r2_buckets": [{ "binding": "MUSIC", "bucket_name": "shop-smug-para-music" }]
}
